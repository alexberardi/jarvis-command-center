# =============================================================================
# jarvis-command-center - Environment Template
# =============================================================================
# Copy to .env and fill in values
# Port: 7703
# Run: bash run-docker-dev.sh
# =============================================================================

# Service URLs are resolved automatically from jarvis-config-service

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DB_TYPE=postgres
DB_URL=postgresql://postgres:postgres@localhost:5432/jarvis_command_center_db

# For migrations (use localhost even when running in Docker)
MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jarvis_command_center_db

# -----------------------------------------------------------------------------
# ADMIN
# -----------------------------------------------------------------------------
# API key for admin endpoints
ADMIN_API_KEY=CHANGE_ME_admin_key

# -----------------------------------------------------------------------------
# LLM PROXY
# -----------------------------------------------------------------------------
JARVIS_LLM_PROXY_API_VERSION=1

# Model interface: JarvisAdapterModel or JarvisModel
JARVIS_MODEL_INTERFACE=JarvisAdapterModel

# Use smaller model for faster responses
JARVIS_SMALL_MODEL_MODE=True

# -----------------------------------------------------------------------------
# TOOL CLASSIFIER (fastText router)
# -----------------------------------------------------------------------------
JARVIS_TOOL_CLASSIFIER_ENABLED=True
JARVIS_TOOL_CLASSIFIER_MODEL_PATH=/app/temp/tool_classifier.bin
JARVIS_TOOL_CLASSIFIER_EXTRA_TRAINING_PATH=/app/temp/tool_router_extra_training.jsonl
JARVIS_TOOL_CLASSIFIER_MIN_CONFIDENCE=0.6
JARVIS_TOOL_ROUTER_FILTER_MIN_CONFIDENCE=0.85

# -----------------------------------------------------------------------------
# PROMPT CONFIGURATION
# -----------------------------------------------------------------------------
JARVIS_SYSTEM_PROMPT_PROVIDER=
JARVIS_PARAMETER_INFERENCE_PROMPT_PROVIDER=
JARVIS_TRANSCRIPTION_CLEANUP_ENABLED=False
JARVIS_PROMPT_INCLUDE_ANTIPATTERNS=True
JARVIS_PROMPT_INCLUDE_PARAM_DESCRIPTIONS=True

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# App-to-app credentials (register with jarvis-auth admin first)
JARVIS_AUTH_APP_ID=command-center
JARVIS_AUTH_APP_KEY=CHANGE_ME_get_from_jarvis_auth_admin
NODE_AUTH_CACHE_TTL=60

# -----------------------------------------------------------------------------
# SERVICE DISCOVERY
# -----------------------------------------------------------------------------
JARVIS_CONFIG_URL=http://localhost:7700

# -----------------------------------------------------------------------------
# CENTRALIZED LOGGING
# -----------------------------------------------------------------------------
JARVIS_APP_ID=command-center
JARVIS_APP_KEY=CHANGE_ME_get_from_jarvis_auth_admin
JARVIS_LOG_CONSOLE_LEVEL=INFO
JARVIS_LOG_REMOTE_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# OAUTH (JCC as redirect authority)
# -----------------------------------------------------------------------------
# External URL for OAuth callback (e.g., https://jarvis.example.com or http://192.168.1.50:8002)
# Falls back to auto-detection from request headers if not set.
# JARVIS_EXTERNAL_URL=http://192.168.1.50:8002

# 32-byte hex key for encrypting OAuth tokens at rest (AES-256-GCM).
# Falls back to SHA-256(SECRET_KEY) if not set.
# JARVIS_TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# Encryption key fallback
# SECRET_KEY=CHANGE_ME_any_string

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=7703

# -----------------------------------------------------------------------------
# DEBUG (optional)
# -----------------------------------------------------------------------------
# DEBUG=True
# DEBUG_PORT=5679
