# ── Database ──────────────────────────────────────────────────
DB_URL=postgresql://postgres:postgres@host.docker.internal:5432/jarvis_command_center
MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jarvis_command_center

# ── Admin ─────────────────────────────────────────────────────
ADMIN_API_KEY=change-me

# ── Service Discovery (only required service URL) ────────────
JARVIS_CONFIG_URL=http://localhost:7700
# Set to "dockerized" when running in Docker to get host.docker.internal URLs
# JARVIS_CONFIG_URL_STYLE=dockerized

# ── Auth ──────────────────────────────────────────────────────
# Legacy fallback - prefer config-service
# JARVIS_AUTH_BASE_URL=
JARVIS_APP_ID=command-center
# Populated by service registration (jarvis-admin → Services page)
JARVIS_APP_KEY=

# ── OAuth Relay ───────────────────────────────────────────────
# Public relay for OAuth bounce (Google, Spotify, etc.). The provider
# redirects here with the auth code; the relay bounces it to the
# mobile app's custom URL scheme. Hosted on Fly — works for all users.
JARVIS_RELAY_URL=https://relay.jarvisautomation.io

# ── MQTT ──────────────────────────────────────────────────────
JARVIS_MQTT_BROKER_URL=mqtt://localhost:1883

# ── Model ─────────────────────────────────────────────────────
JARVIS_MODEL_INTERFACE=JarvisAdapterModel

# ── Logging ───────────────────────────────────────────────────
JARVIS_LOG_CONSOLE_LEVEL=INFO
JARVIS_LOG_REMOTE_LEVEL=DEBUG
